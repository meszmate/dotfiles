#!/usr/bin/env bash
# Claude Code hook → desktop notification (swaync). Wired into
# ~/.claude/settings.json by setup/arch.sh for the Notification and Stop events:
#   Notification  – Claude needs input (permission prompt, idle question, ...)
#   Stop          – Claude finished a turn (only when its window isn't focused)
# Reads the hook JSON from stdin.
set -uo pipefail
command -v notify-send >/dev/null || exit 0
input=$(cat)
event=$(printf '%s' "$input" | jq -r '.hook_event_name // ""')
cwd=$(printf '%s' "$input" | jq -r '.cwd // ""')
project=${cwd##*/}
[[ -z "$project" ]] && project="Claude Code"

case "$event" in
    Notification)
        msg=$(printf '%s' "$input" | jq -r '.message // "Claude needs your attention"')
        title=$(printf '%s' "$input" | jq -r '.title // empty')
        notify-send -a "Claude Code" -i utilities-terminal -u normal \
            "${title:-Claude · $project}" "$msg" ;;
    Stop)
        # skip when a Claude terminal is the focused window — you're already looking at it
        active=$(hyprctl activewindow -j 2>/dev/null | jq -r '(.title // "") + " " + (.class // "")')
        if printf '%s' "$active" | grep -qiE 'claude'; then exit 0; fi
        notify-send -a "Claude Code" -i utilities-terminal -u normal \
            "Claude finished · $project" "The agent is waiting for you." ;;
    *) exit 0 ;;
esac
