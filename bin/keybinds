def partition(weights, k):
    """Split indices 0..n-1 into k contiguous runs minimising the tallest run."""
    n = len(weights)
    if n <= k:
        return [[i] for i in range(n)] + [[] for _ in range(k - n)]
    prefix = [0]
    for w in weights:
        prefix.append(prefix[-1] + w)
    INF = float("inf")
    best = [[INF] * (k + 1) for _ in range(n + 1)]
    cut = [[0] * (k + 1) for _ in range(n + 1)]
    best[0][0] = 0
    for j in range(1, k + 1):
        for i in range(1, n + 1):
            for p in range(j - 1, i):
                h = max(best[p][j - 1], prefix[i] - prefix[p])
                if h < best[i][j]:
                    best[i][j], cut[i][j] = h, p
    runs, i = [], n
    for j in range(k, 0, -1):
        p = cut[i][j]
        runs.append(list(range(p, i)))
        i = p
    return runs[::-1]


def keycap(label, cls=None):
    lbl = Gtk.Label(label=label)
    lbl.add_css_class("key")
    if cls:
        lbl.add_css_class(cls)
    return lbl


def small(text, cls):
    lbl = Gtk.Label(label=text)
    lbl.add_css_class(cls)
    return lbl


class Cheatsheet(Gtk.Application):
    def __init__(self, data):
        super().__init__(application_id="dev.meszmate.keybinds", flags=0)
        self.data = data
        self.rows = []       # ((keys_widget, desc_widget), haystack, section_widget)
        self.sections = []   # (section_widget, [row_widgets…])

    def do_activate(self):
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        win = Gtk.ApplicationWindow(application=self)
        LS.init_for_window(win)
        LS.set_layer(win, LS.Layer.OVERLAY)
        LS.set_namespace(win, "keybinds")
        LS.set_keyboard_mode(win, LS.KeyboardMode.EXCLUSIVE)
        for edge in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
            LS.set_anchor(win, edge, True)
        LS.set_exclusive_zone(win, -1)

        mon = Gdk.Display.get_default().get_monitors()[0].get_geometry()
        total = sum(len(rows) for _, rows in self.data["sections"])
        columns = 3 if total > 40 else 2
        card_w = min(1520 if columns == 3 else 1080, int(mon.width * 0.9))
        max_h = int(mon.height * 0.88)

        overlay = Gtk.Overlay()
        scrim = Gtk.Box()
        scrim.add_css_class("scrim")
        click = Gtk.GestureClick()
        click.connect("released", lambda *_: self.quit())
        scrim.add_controller(click)
        overlay.set_child(scrim)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        card.add_css_class("card")
        card.set_size_request(card_w, -1)
        overlay.add_overlay(card)

        # header
        head = Gtk.Box()
        head.append(small(self.data["icon"], "title-icon"))
        head.append(small(self.data["title"], "title"))
        sub = small(f"{total} shortcuts  ·  {self.data['source']}", "subtitle")
        sub.set_valign(Gtk.Align.BASELINE)
        head.append(sub)
        head.append(Gtk.Box(hexpand=True))
        self.search = Gtk.SearchEntry(placeholder_text="Search shortcuts…")
        self.search.add_css_class("search")
        self.search.connect("search-changed", self.filter)
        self.search.connect("stop-search", lambda *_: self.quit())
        head.append(self.search)
        card.append(head)

        # body: columns of section cards, config order kept, heights balanced
        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER,
                                      propagate_natural_height=True, max_content_height=max_h - 150)
        cols = Gtk.Box(spacing=12, homogeneous=True, valign=Gtk.Align.START)
        col_boxes = [Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12) for _ in range(columns)]
        for c in col_boxes:
            cols.append(c)
        data = self.data["sections"]
        for i, chunk in enumerate(partition([2.4 + len(rows) for _, rows in data], columns)):
            for j in chunk:
                widget, row_widgets = self.build_section(*data[j])
                col_boxes[i].append(widget)
                self.sections.append((widget, row_widgets))
        self.empty = small("No shortcut matches that", "empty")
        self.empty.set_visible(False)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body.append(cols)
        body.append(self.empty)
        scroller.set_child(body)
        card.append(scroller)

        # footer
        foot = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
        foot.add_css_class("footer")
        hints = [[("Esc", None), " close"], [("Type", None), " to search"], self.data["toggle"] + [" toggle"]]
        for parts in hints:
            for p in parts:
                if p == "+":
                    foot.append(small("+", "plus"))
                elif isinstance(p, str):
                    foot.append(Gtk.Label(label=p.strip()))
                else:
                    foot.append(keycap(*p))
            foot.append(small("·", "or"))
        foot.remove(foot.get_last_child())
        card.append(foot)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        win.add_controller(keys)

        win.set_child(overlay)
        win.present()
        self.search.grab_focus()

    def build_section(self, name, rows):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.add_css_class("section")
        title = Gtk.Box()
        title.append(small(section_icon(name), "section-icon"))
        title.append(small(name.upper(), "section-title"))
        title.append(Gtk.Box(hexpand=True))
        title.append(small(str(len(rows)), "section-count"))
        box.append(title)

        grid = Gtk.Grid(row_spacing=5, column_spacing=14)
        widgets = []
        for r, row in enumerate(rows):
            keys = Gtk.Box(valign=Gtk.Align.CENTER)
            keys.add_css_class("row")
            for label, cls in row["mods"]:
                keys.append(keycap(label, cls))
                keys.append(small("+", "plus"))
            for i, k in enumerate(row["keys"]):
                if i:
                    keys.append(small("/", "or"))
                keys.append(keycap(k))
            desc = Gtk.Label(label=row["desc"], xalign=0, hexpand=True, ellipsize=3)
            desc.add_css_class("desc")
            grid.attach(keys, 0, r, 1, 1)
            grid.attach(desc, 1, r, 1, 1)
            hay = " ".join([name, row["desc"]] + [m for m, _ in row["mods"]] + row["keys"]).lower()
            self.rows.append(((keys, desc), hay, box))
            widgets.append((keys, desc))
        box.append(grid)
        return box, widgets

    def filter(self, entry):
        terms = entry.get_text().lower().split()
        visible = set()
        for (keys, desc), hay, section in self.rows:
            show = all(t in hay for t in terms)
            keys.set_visible(show)
            desc.set_visible(show)
            if show:
                visible.add(section)
        for section, _ in self.sections:
            section.set_visible(section in visible)
        self.empty.set_visible(not visible)

    def on_key(self, _ctl, keyval, _code, state):
        if keyval == Gdk.KEY_Escape:
            self.quit()
            return True
        if keyval == Gdk.KEY_f and state & Gdk.ModifierType.CONTROL_MASK:
            self.search.grab_focus()
            return True
        if not self.search.has_focus() and Gdk.keyval_to_unicode(keyval) and not state & Gdk.ModifierType.CONTROL_MASK:
            self.search.grab_focus()
        return False


if __name__ == "__main__":
    if toggle_running():
        sys.exit(0)
    with open(PIDFILE, "w") as f:
        f.write(f"{os.getpid()} {MODE}")
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        Cheatsheet(load()).run([])
    finally:
        try:
            if open(PIDFILE).read().split()[0] == str(os.getpid()):
                os.unlink(PIDFILE)
        except (OSError, IndexError):
            pass
