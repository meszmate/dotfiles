#!/usr/bin/env python3
"""Waybar weather module (wttr.in). Cached for 30 min so a flaky connection
never breaks the bar; on total failure the module just hides.

Settings via environment (put them in ~/.config/environment.d or the exec line):
  WEATHER_UNIT=C|F     default C
  WEATHER_LOCATION     e.g. "Kecskemet" — default: auto by IP
"""
import json, os, sys, time, urllib.parse, urllib.request
from datetime import datetime

UNIT = os.environ.get("WEATHER_UNIT", "C").upper()
LOCATION = os.environ.get("WEATHER_LOCATION", "")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "waybar-weather.json")
CACHE_TTL = 30 * 60

ICONS = {
    "113": "󰖙", "116": "󰖕", "119": "󰖐", "122": "󰖐", "143": "󰖑", "176": "󰖗", "179": "󰖘", "182": "󰖘",
    "185": "󰖗", "200": "󰖓", "227": "󰖘", "230": "󰼶", "248": "󰖑", "260": "󰖑", "263": "󰖗", "266": "󰖗",
    "281": "󰖗", "284": "󰖗", "293": "󰖗", "296": "󰖗", "299": "󰖖", "302": "󰖖", "305": "󰖖", "308": "󰖖",
    "311": "󰖗", "314": "󰖖", "317": "󰖘", "320": "󰖘", "323": "󰖘", "326": "󰖘", "329": "󰼶", "332": "󰼶",
    "335": "󰼶", "338": "󰼶", "350": "󰖘", "353": "󰖗", "356": "󰖖", "359": "󰖖", "362": "󰖘", "365": "󰖘",
    "368": "󰖘", "371": "󰼶", "374": "󰖘", "377": "󰖘", "386": "󰖓", "389": "󰖓", "392": "󰖓", "395": "󰼶",
}


def fetch():
    q = urllib.parse.quote(LOCATION)
    url = f"https://wttr.in/{q}?format=j1"
    req = urllib.request.Request(url, headers={"User-Agent": "curl/8"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def load():
    try:
        st = os.stat(CACHE)
        if time.time() - st.st_mtime < CACHE_TTL:
            with open(CACHE) as f:
                return json.load(f)
    except OSError:
        pass
    try:
        data = fetch()
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE, "w") as f:
            json.dump(data, f)
        return data
    except Exception:
        try:
            with open(CACHE) as f:
                return json.load(f)  # stale is better than nothing
        except OSError:
            return None


def t(obj, key):  # temp helper honouring the unit (wttr uses temp_C but FeelsLikeC/tempC)
    v = obj.get(f"{key}{UNIT}") or obj.get(f"{key}_{UNIT}") or "?"
    return v + "°"


data = load()
if not data:
    print(json.dumps({"text": "", "tooltip": "weather unavailable"}))
    sys.exit(0)

cur = data["current_condition"][0]
icon = ICONS.get(cur["weatherCode"], "󰖐")
area = data.get("nearest_area", [{}])[0]
place = (area.get("areaName", [{}])[0].get("value", "") if area else "")

text = f"{icon} {t(cur, 'FeelsLike')}"
tip = [f"<b>{cur['weatherDesc'][0]['value']}</b>  {t(cur, 'temp')}  (feels {t(cur, 'FeelsLike')})"]
if place:
    tip.append(place)
tip.append(f"󰖝 {cur['windspeedKmph']} km/h {cur['winddir16Point']}   󰖎 {cur['humidity']}%   󰖒 {cur['precipMM']} mm")

wk = "F" if UNIT == "F" else "C"
for i, day in enumerate(data["weather"][:3]):
    name = "Today" if i == 0 else ("Tomorrow" if i == 1 else datetime.strptime(day["date"], "%Y-%m-%d").strftime("%A"))
    tip.append(f"\n<b>{name}</b>  󰔵 {day['maxtemp' + wk]}° 󰔳 {day['mintemp' + wk]}°   󰖜 {day['astronomy'][0]['sunrise']}  󰖛 {day['astronomy'][0]['sunset']}")
    now_h = datetime.now().hour
    for h in day["hourly"]:
        hh = int(h["time"]) // 100
        if i == 0 and hh < now_h - 2:
            continue
        chance = h.get("chanceofrain", "0")
        rain = f"  {chance}%" if chance not in ("0", "") else ""
        tip.append(f"{hh:02d}:00 {ICONS.get(h['weatherCode'], '󰖐')} {t(h, 'FeelsLike'):>4} {h['weatherDesc'][0]['value']}{rain}")

print(json.dumps({"text": text, "tooltip": "\n".join(tip), "class": "weather"}))
