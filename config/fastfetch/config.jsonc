// fastfetch — Catppuccin Mocha, matches the kitty/waybar look.
// Shown on new kitty shells (home/.zshrc) and via `ff`. `onefetch` does the same for git repos.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch",
        "color": { "1": "blue", "2": "magenta" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "magenta", "title": "blue", "separator": "bright_black" },
        "key": { "width": 14 },
        "size": { "binaryPrefix": "si", "ndigits": 1 },
        "percent": { "type": 3 },
        "bar": { "char": { "elapsed": "━", "total": "━" }, "width": 12, "border": { "left": "", "right": "" } }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
            "color": { "user": "magenta", "at": "white", "host": "blue" }
        },
        { "type": "custom", "format": "{#90}─────────────────────────────────────{#}" },
        { "type": "os",       "key": "󰣇  os",       "format": "{pretty-name} {arch}" },
        { "type": "kernel",   "key": "󰌽  kernel" },
        { "type": "wm",       "key": "󰖯  wm",       "format": "{pretty-name} {version}" },
        { "type": "packages", "key": "󰏖  packages" },
        { "type": "shell",    "key": "󰆍  shell" },
        { "type": "terminal", "key": "  terminal" },
        { "type": "uptime",   "key": "󰅐  uptime" },
        { "type": "custom", "format": "{#90}─────────────────────────────────────{#}" },
        { "type": "cpu",      "key": "󰍛  cpu",      "format": "{name} · {cores-physical}c/{cores-logical}t", "showPeCoreCount": false },
        { "type": "gpu",      "key": "󰢮  gpu",      "format": "{name}", "detectionMethod": "pci" },
        { "type": "memory",   "key": "󰘚  memory",   "format": "{used} / {total} {percentage}" },
        { "type": "disk",     "key": "󰋊  disk",     "folders": "/", "format": "{size-used} / {size-total} {size-percentage}" },
        { "type": "display",  "key": "󰍹  display",  "format": "{width}×{height} @ {refresh-rate}Hz", "compactType": "original-with-refresh-rate" },
        { "type": "battery",  "key": "󰁹  battery",  "format": "{capacity} {status}", "temp": false },
        { "type": "localip",  "key": "󰩟  ip",       "showIpv6": false, "showPrefixLen": false, "compact": true },
        { "type": "locale",   "key": "󰗊  locale" },
        { "type": "custom", "format": "{#90}─────────────────────────────────────{#}" },
        { "type": "colors", "symbol": "circle", "paddingLeft": 2, "block": { "range": [0, 7] } }
    ]
}
