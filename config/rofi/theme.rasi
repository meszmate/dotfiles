/* Catppuccin Mocha launcher theme — used by config.rasi (drun etc.) */

* {
    /* palette */
    base:      #1e1e2e;
    mantle:    #181825;
    crust:     #11111b;
    surface0:  #313244;
    surface1:  #45475a;
    surface2:  #585b70;
    overlay0:  #6c7086;
    overlay1:  #7f849c;
    subtext0:  #a6adc8;
    text:      #cdd6f4;
    mauve:     #cba6f7;
    blue:      #89b4fa;
    lavender:  #b4befe;
    red:       #f38ba8;
    green:     #a6e3a1;
    yellow:    #f9e2af;
    peach:     #fab387;

    accent:    @mauve;

    background-color: transparent;
    text-color:       @text;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    location:         center;
    anchor:           center;
    width:            680px;
    border:           2px;
    border-color:     @accent;
    border-radius:    18px;
    background-color: #1e1e2ef2;
    cursor:           "default";
}

mainbox {
    padding:  18px;
    spacing:  12px;
    children: [ inputbar, message, listview, mode-switcher ];
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          12px 16px;
    border-radius:    12px;
    background-color: @surface0;
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 12";
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search…";
    placeholder-color: @overlay0;
    cursor:            text;
    vertical-align:    0.5;
}

message {
    padding:          10px 14px;
    border-radius:    10px;
    background-color: @surface0;
}

textbox {
    text-color: @subtext0;
}

listview {
    columns:      1;
    lines:        8;
    fixed-height: true;
    dynamic:      true;
    scrollbar:    false;
    spacing:      4px;
    cycle:        true;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 10px;
    cursor:        pointer;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}
element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color:       @red;
}
element normal.active, element alternate.active {
    background-color: transparent;
    text-color:       @green;
}
element selected.normal {
    background-color: @surface1;
    text-color:       @accent;
}
element selected.urgent {
    background-color: @red;
    text-color:       @base;
}
element selected.active {
    background-color: @green;
    text-color:       @base;
}

element-icon {
    size:           28px;
    vertical-align: 0.5;
    cursor:         inherit;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    highlight:      bold #cba6f7;
    cursor:         inherit;
}

mode-switcher {
    spacing: 8px;
}

button {
    padding:          8px;
    border-radius:    10px;
    background-color: @surface0;
    text-color:       @subtext0;
    horizontal-align: 0.5;
    cursor:           pointer;
}

button selected {
    background-color: @accent;
    text-color:       @base;
}

error-message {
    padding:          20px;
    border-radius:    12px;
    background-color: @base;
    text-color:       @red;
}
