#!/usr/bin/env bash
# Searchable cheatsheet of every Hyprland keybind that has a description
# (SUPER+/). Escape/Enter closes it.
set -uo pipefail
THEME="$HOME/.config/rofi/menu.rasi"

rows=$(hyprctl binds -j | jq -r '
  def mods: [ (if (.modmask % 128) >= 64 then "SUPER" else empty end),
              (if (.modmask % 8)  >= 4  then "CTRL"  else empty end),
              (if (.modmask % 16) >= 8  then "ALT"   else empty end),
              (if (.modmask % 2)  >= 1  then "SHIFT" else empty end) ] | join("+");
  map(select(.description != "" and .submap == ""))
  | sort_by((.modmask % 128 < 64), .modmask, .key)
  | .[]
  | "\((if (mods) == "" then .key else (mods) + "+" + .key end) | . + (" " * (24 - length)))  \(.description)"')

printf '%s\n' "$rows" | rofi -dmenu -i -p "$USER@$(uname -n) ~ \$ hyprctl binds" -theme "$THEME" \
    -theme-str 'window { width: 800px; } listview { lines: 14; } element-text { font: "JetBrainsMono Nerd Font 11"; }' \
    -mesg "SUPER+/ · type to filter · Esc to close" >/dev/null || true
