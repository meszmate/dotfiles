#!/usr/bin/env bash
# Small, fast status snippets for hyprlock labels: lockinfo <name|battery|network|media|host>
set -uo pipefail
case "${1:-}" in
    name)
        full=$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)
        printf '%s' "${full:-$USER}" ;;
    host)
        printf '%s@%s' "$USER" "$(uname -n)" ;;
    battery)
        bat=$(command ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1)
        [[ -z "$bat" ]] && exit 0
        cap=$(<"$bat/capacity"); status=$(<"$bat/status")
        icons=(󰂎 󰁺 󰁻 󰁼 󰁽 󰁾 󰁿 󰂀 󰂁 󰂂 󰁹)
        icon=${icons[$(( cap / 10 ))]}
        [[ "$status" == "Charging" ]] && icon="󰂄"
        [[ "$status" == "Full" || ( "$status" == "Not charging" && cap -ge 95 ) ]] && icon="󰚥"
        printf '%s %s%%' "$icon" "$cap" ;;
    network)
        # manager-agnostic: default-route interface + kernel wireless info
        iface=$(ip -o route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}')
        if [[ -z "$iface" ]]; then
            [[ "$(nmcli -t -f WIFI general 2>/dev/null)" == "disabled" ]] && printf '󰤭 Wi-Fi off' || printf '󰤮 Offline'
            exit 0
        fi
        if [[ -d "/sys/class/net/$iface/wireless" ]]; then
            ssid=$(nmcli -t -f ACTIVE,SSID device wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')
            [[ -z "$ssid" ]] && ssid=$(iwctl station "$iface" show 2>/dev/null | sed -n 's/.*Connected network *//p' | sed 's/[[:space:]]*$//' | head -1)
            [[ -z "$ssid" ]] && ssid=$(iw dev "$iface" link 2>/dev/null | sed -n 's/.*SSID: //p')
            q=$(awk -v i="$iface:" '$1==i {gsub(/\./,"",$3); print $3}' /proc/net/wireless 2>/dev/null)
            icons=(󰤯 󰤟 󰤢 󰤥 󰤨)
            idx=$(( ${q:-70} * 4 / 70 )); (( idx > 4 )) && idx=4
            printf '%s %s' "${icons[$idx]}" "${ssid:-Wi-Fi}"
        else
            printf '󰈀 %s' "$iface"
        fi ;;
    media)
        status=$(playerctl status 2>/dev/null) || exit 0
        [[ "$status" != "Playing" ]] && exit 0
        playerctl metadata --format '󰎇 {{artist}} — {{title}}' 2>/dev/null | cut -c1-70 ;;
esac
