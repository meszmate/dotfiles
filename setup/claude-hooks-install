#!/usr/bin/env bash
# Applies this repo's Claude Code preferences to ~/.claude/settings.json without
# touching anything else in there. Idempotent — safe to re-run.
#   • the claude-notify hooks (setup/claude-hooks.json)
#   • includeCoAuthoredBy = false — keeps "Co-Authored-By: Claude" and the
#     "Generated with Claude Code" line out of commit messages and PR bodies
set -euo pipefail
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
FRAGMENT="$DOTFILES_DIR/setup/claude-hooks.json"
SETTINGS="$HOME/.claude/settings.json"

command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
mkdir -p "$HOME/.claude"
[[ -s "$SETTINGS" ]] || echo '{}' > "$SETTINGS"

tmp=$(mktemp)
jq -s '
  .[0] as $cur | .[1].hooks as $add
  | $cur
  | .hooks = ($cur.hooks // {})
  | reduce ($add | keys[]) as $ev (.;
      if ([ .hooks[$ev][]?.hooks[]?.command // "" ] | any(contains("claude-notify")))
      then .
      else .hooks[$ev] = ((.hooks[$ev] // []) + $add[$ev])
      end)
  | .includeCoAuthoredBy = false
' "$SETTINGS" "$FRAGMENT" > "$tmp"
if cmp -s "$tmp" "$SETTINGS"; then
    rm -f "$tmp"; echo "$SETTINGS already up to date"
else
    cp "$SETTINGS" "$SETTINGS.bak"
    mv "$tmp" "$SETTINGS"
    echo "hooks + includeCoAuthoredBy written to $SETTINGS (backup: settings.json.bak)"
fi
